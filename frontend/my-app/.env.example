# Copy to .env.local and fill in your Firebase web app values.
# .env.local is gitignored; never commit real keys or debug tokens.
# Firebase console: Project settings > General > Your apps > Web app config.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Firebase config values.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloud fallback model for hybrid inference.
# Default when unset: gemini-3.5-flash-lite (documented Firebase default).
NEXT_PUBLIC_AILOGIC_CLOUD_MODEL=gemini-3.5-flash-lite

# reCAPTCHA Enterprise site key for App Check (Security > App Check > Apps).
# Without this, cloud calls fail with 403 when App Check is enforced.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# Optional stable App Check debug token for localhost (dev only).
# Register it under Security > App Check > Apps > Manage debug tokens.
# When unset in development, the SDK auto-generates a token (see browser console).
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# FastAPI backend base URL for PDF text extraction (Phase 3).
# Default when unset: http://localhost:8000 (uvicorn app.main:app).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
