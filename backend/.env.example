# OpporCheck backend environment (copy per environment; never commit values).
# Local development needs NOTHING set (secure localhost defaults apply).

# --- Firebase Auth (REQUIRED for every protected route) ---
# Firebase project ID the backend accepts ID tokens for (token audience).
# Without this, all protected routes answer 503. No service-account key
# is needed: verification is offline cryptography against Google certs.
FIREBASE_PROJECT_ID=

# --- Deployment origins (set in production) ---
# Exact frontend origin(s), comma-separated. No localhost in production.
# Example: FRONTEND_ORIGINS=https://opporcheck.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Host header allowlist. On Railway: the service domain (and custom
# domain, if any). Example: OPPORCHECK_ALLOWED_HOSTS=api.up.railway.app
OPPORCHECK_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Rate limiting ---
# Requests/min/IP (0 disables). Behind Railway's edge, pair with proxy trust below.
OPPORCHECK_RATE_LIMIT_PER_MINUTE=60
# Trust X-Real-IP for client identity. Set ONLY behind Railway's public
# edge (which overwrites the header per request); anywhere else it lets
# callers spoof their rate-limit bucket. Default off (socket peer used).
TRUST_PROXY_HEADERS=false

# --- OCR tuning (optional; defaults are the measured-safe values) ---
# Model cache location (container default: /opt/models via Dockerfile).
OCR_MODEL_CACHE=
# PDF render resolution, clamped 72-200 (Phase 0: 300 DPI added cost only).
OCR_RENDER_DPI=150
# PaddleX 1-second hoster healthcheck bypass (proxied networks only).
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=
